# Required — filled interactively on first ./run.sh if left empty
# Classic PAT with scopes: read:user, user:follow
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Bot loop: each cycle searches by criteria, then follows from the queue
# BOT_MODE=both                    # both | discover (search only) | follow
# USER_SOURCE=cursor               # cursor criteria | random
# FETCH_COUNT=20                   # candidates per search cycle

# Search channels (comma) and optional pipe-separated queries:
# DISCOVERY_CHANNELS=users,repos,stargazers,contributors,code
# CURSOR_USER_QUERIES=cursor in:bio|"cursor ide" in:bio
# CURSOR_REPO_QUERIES=topic:cursor|topic:cursor-ai
# CURSOR_CODE_QUERIES=filename:.cursorrules|path:.cursor/rules

# Timing / limits
# FOLLOW_DELAY_MIN=3
# FOLLOW_DELAY_MAX=6
# LOOP_SLEEP_SECONDS=90
# MAX_CALLS_PER_HOUR=1000
# BOT_DATA_DIR=
# USERNAMES_FILE=
# STATE_FILE=
# LOG_FILE=
# USER_AGENT=GitHubFollowerBot

# Filters
# FILTER_USERS_ONLY=1
# FILTER_SKIP_SITE_ADMIN=1
# FILTER_SKIP_BOT_LOGINS=1
# FILTER_SKIP_ALREADY_FOLLOWING=1
# FILTER_ON_FOLLOW=1
# MIN_FOLLOWERS=
# MAX_FOLLOWERS=
# MIN_FOLLOWING=
# MAX_FOLLOWING=
# MIN_REPOS=
# MAX_REPOS=
# REQUIRE_BIO=0
# REQUIRE_LOCATION=0
# REQUIRE_HIREABLE=0
# LOCATION_CONTAINS=
# LOCATION_EXCLUDE=
# LOGIN_EXCLUDE=

# Dead / inactive (default: inactive > 30 days = dead)
# FILTER_SKIP_DEAD=1
# MAX_INACTIVE_DAYS=30
# FILTER_REQUIRE_PUBLIC_EVENTS=1
# FILTER_SKIP_EMPTY_PROFILES=1
