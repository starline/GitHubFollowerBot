# Copy to .env and fill in values:
#   cp .env.example .env

# Required: classic PAT with scopes read:user, user:follow
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional tuning
FETCH_COUNT=50
FOLLOW_DELAY_MIN=3
FOLLOW_DELAY_MAX=6
LOOP_SLEEP_SECONDS=90
MAX_CALLS_PER_HOUR=1000
USERNAMES_FILE=usernames.txt
STATE_FILE=state.json
USER_AGENT=GitHubFollowerBot
