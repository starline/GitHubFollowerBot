# Required — filled interactively on first ./run.sh if left empty
# Classic PAT with scopes: read:user, user:follow
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Source of candidates: cursor (default) | random
# USER_SOURCE=cursor
# BOT_MODE=both                 # both | discover | follow
# DISCOVERY_CHANNELS=users,repos,stargazers,contributors,code
# Pipe-separated custom queries (optional; defaults are built-in):
# CURSOR_USER_QUERIES=cursor in:bio|"cursor ide" in:bio
# CURSOR_REPO_QUERIES=topic:cursor|topic:cursor-ai
# CURSOR_CODE_QUERIES=filename:.cursorrules|path:.cursor/rules

# Optional — defaults shown
# FETCH_COUNT=50
# FOLLOW_DELAY_MIN=3
# FOLLOW_DELAY_MAX=6
# LOOP_SLEEP_SECONDS=90
# MAX_CALLS_PER_HOUR=1000
# BOT_DATA_DIR=              # default: ./data
# USERNAMES_FILE=            # default: ./data/usernames.txt
# STATE_FILE=                # default: ./data/state.json
# LOG_FILE=                  # default: ./data/github_follow.log
# USER_AGENT=GitHubFollowerBot

# Filters (cheap list checks — on by default)
# FILTER_USERS_ONLY=1              # skip Organization / Bot types
# FILTER_SKIP_SITE_ADMIN=1
# FILTER_SKIP_BOT_LOGINS=1         # * [bot], *-bot, bot-*
# FILTER_SKIP_ALREADY_FOLLOWING=1
# FILTER_ON_FOLLOW=1               # re-check queued users before follow

# Profile filters (extra GET /users/{login} when any is set)
# MIN_FOLLOWERS=
# MAX_FOLLOWERS=
# MIN_FOLLOWING=
# MAX_FOLLOWING=
# MIN_REPOS=
# MAX_REPOS=
# REQUIRE_BIO=0
# REQUIRE_LOCATION=0
# REQUIRE_HIREABLE=0
# LOCATION_CONTAINS=               # comma substrings, e.g. russia,moscow
# LOCATION_EXCLUDE=
# LOGIN_EXCLUDE=                   # exact logins, comma-separated

# Dead / inactive users (on by default)
# FILTER_SKIP_DEAD=1
# MAX_INACTIVE_DAYS=30             # profile updated_at + last public event
# FILTER_REQUIRE_PUBLIC_EVENTS=1   # must have a public event within MAX_INACTIVE_DAYS
# FILTER_SKIP_EMPTY_PROFILES=1     # 0 repos and 0 followers
